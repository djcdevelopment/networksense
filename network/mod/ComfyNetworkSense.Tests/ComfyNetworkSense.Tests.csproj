<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\ComfyQuestRuntime\LiveTest\manifest.json" Link="LiveTest\manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\ComfyQuestRuntime\LiveTest\experiences\omen-inscription.json" Link="LiveTest\experiences\omen-inscription.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ComfyQuestContracts\ComfyQuestContracts.csproj" />
  </ItemGroup>

  <!-- ValheimRoutedRpcAdmissions.cs and the 4 Zdo/vehicle relevance policies moved to
       Lumberjacks/src/Comfy.Transport.Contracts/ and now arrive as contentFiles (source) from the
       Comfy.Transport.Contracts package — no assembly reference, so the transport/policy tests below
       keep exercising the exact compiled-in source rather than a separately-compiled DLL. -->
  <ItemGroup>
    <PackageReference Include="Comfy.Transport.Contracts" Version="0.1.0-local"
                       IncludeAssets="contentFiles" ExcludeAssets="compile;runtime" />
  </ItemGroup>

  <!-- LINKED, not ProjectReference, and that is the whole design. ComfyNetworkSense targets net48
       against Valheim's own assemblies, so referencing it would drag Unity into this project and put
       us back where we started: bounds nobody can drive without a game install. BoundedRawHttp.cs is
       Unity-free by construction, so compiling that one file in gives real coverage of the real source
       with no Valheim, no BepInEx, no net48 targeting pack. If this ever needs a second linked file,
       that file must be Unity-free too - otherwise fix the design, not this csproj. -->
  <ItemGroup>
    <Compile Include="..\ComfyNetworkSense\Core\Parsing\WireParsers.cs" Link="WireParsers.cs" />
    <Compile Include="..\ComfyNetworkSense\Core\Services\BoundedRawHttp.cs" Link="BoundedRawHttp.cs" />
    <Compile Include="..\ComfyNetworkSense\Core\Services\ReliableAckBarrier.cs" Link="ReliableAckBarrier.cs" />
    <Compile Include="..\ComfyNetworkSense\Core\Services\RoutedRpcWireFields.cs" Link="RoutedRpcWireFields.cs" />
    <Compile Include="..\ComfyNetworkSense\Core\Services\SaddleAuthorityTransferPolicy.cs" Link="SaddleAuthorityTransferPolicy.cs" />
    <Compile Include="..\ComfyNetworkSense\Core\Services\ShipCutoverModePolicy.cs" Link="ShipCutoverModePolicy.cs" />
    <Compile Include="..\ComfyNetworkSense\Core\Services\ContainerTransactionPolicy.cs" Link="ContainerTransactionPolicy.cs" />
    <Compile Include="..\ComfyNetworkSense\Core\Services\CreatureAiProofPolicy.cs" Link="CreatureAiProofPolicy.cs" />
    <Compile Include="..\ComfyNetworkSense\Core\Services\ZdoJournalInterestPolicy.cs" Link="ZdoJournalInterestPolicy.cs" />
    <Compile Include="..\ComfyNetworkSense\Core\Services\SessionSendGuard.cs" Link="SessionSendGuard.cs" />
    <Compile Include="..\ComfyNetworkSense\Core\Services\ResumeReattachPolicy.cs" Link="ResumeReattachPolicy.cs" />
    <Compile Include="..\ComfyNetworkSense\Core\Services\AlphaTransportSwitches.cs" Link="AlphaTransportSwitches.cs" />
    <Compile Include="..\ComfyNetworkSense\Core\Services\ValheimMotionCodec.cs" Link="ValheimMotionCodec.cs" />
    <Compile Include="..\ComfyNetworkSense\Core\Services\GameplayEventClassifier.cs" Link="GameplayEventClassifier.cs" />
    <Compile Include="..\ComfyNetworkSense\Core\Services\LivePlayerTargetPolicy.cs" Link="LivePlayerTargetPolicy.cs" />
    <Compile Include="..\ComfyQuestLab\Core\BlueprintFile.cs" Link="BlueprintFile.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabCaptureContract.cs" Link="LabCaptureContract.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabPanelLayout.cs" Link="LabPanelLayout.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabDemoReadiness.cs" Link="LabDemoReadiness.cs" />
    <Compile Include="..\ComfyQuestContracts\ModGlue\TrackedQuest.cs" Link="TrackedQuest.cs" />
    <Compile Include="..\ComfyQuestContracts\ModGlue\QuestEvent.cs" Link="QuestEvent.cs" />
    <Compile Include="..\ComfyQuestContracts\ModGlue\QuestViewLoader.cs" Link="QuestViewLoader.cs" />
    <Compile Include="..\ComfyQuestContracts\ModGlue\QuestTriggerEvaluator.cs" Link="QuestTriggerEvaluator.cs" />
    <Compile Include="..\ComfyQuestContracts\ModGlue\QuestEventCatalog.g.cs" Link="QuestEventCatalog.g.cs" />
    <Compile Include="..\ComfyQuestContracts\ModGlue\QuestAuthoring.cs" Link="QuestAuthoring.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabQuestSet.cs" Link="LabQuestSet.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabQuestAdvisor.cs" Link="LabQuestAdvisor.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabQuestSeed.cs" Link="LabQuestSeed.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabCreatureNaming.cs" Link="LabCreatureNaming.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabActionDedupe.cs" Link="LabActionDedupe.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabBatchContract.cs" Link="LabBatchContract.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabScenarioContract.cs" Link="LabScenarioContract.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabRuntimeProfile.cs" Link="LabRuntimeProfile.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabTreeRecoveryContract.cs" Link="LabTreeRecoveryContract.cs" />
    <!-- Generated, and Unity-free by construction (plain floats and strings) — linked so the
         seed can be asserted against the gallery the seed is meant to be practised in. It names
         its categories from LabEvents, which is Unity-free for the same reason. -->
    <Compile Include="..\ComfyQuestLab\Core\LabEvents.cs" Link="LabEvents.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabEventArchive.cs" Link="LabEventArchive.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabGalleryPlan.g.cs" Link="LabGalleryPlan.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\tools\synthetic-baseline-extractor\synthetic_baseline_v2.json"
          Link="synthetic_baseline_v2.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
