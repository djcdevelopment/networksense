<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ComfyNetworkSense</AssemblyName>
    <RootNamespace>ComfyNetworkSense</RootNamespace>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <!-- The quest contract now arrives via contentFiles from the NuGet global-packages cache
         (a per-machine path under the user profile, not a repo-relative one). Map it too, so the
         SHA-verified single-DLL lane stays deterministic across machines/profiles, not just across
         directories inside this repo. -->
    <PathMap Condition="'$(PathMap)' == ''">$(MSBuildProjectDirectory)=C:\src\ComfyNetworkSense,$(NuGetPackageRoot)=C:\nuget\</PathMap>
    <Optimize>true</Optimize>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <PluginOutputPath Condition="'$(PluginOutputPath)' == ''">$(ValheimDir)\BepInEx\plugins</PluginOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(ValheimDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(ValheimDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimDir)\valheim_Data\Managed\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimDir)\valheim_Data\Managed\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime.Serialization">
      <HintPath>$(ValheimDir)\valheim_Data\Managed\System.Runtime.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimDir)\valheim_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimDir)\valheim_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ValheimDir)\valheim_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(ValheimDir)\valheim_Data\Managed\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ValheimDir)\valheim_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ValheimDir)\valheim_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ValheimDir)\valheim_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <None Include="CHANGELOG.md" />
    <None Include="manifest.json" />
    <None Include="README.md" />
  </ItemGroup>

  <!-- The quest contract (TrackedQuest/QuestEvent/QuestViewLoader/QuestTriggerEvaluator/
       QuestEventCatalog/QuestAuthoring) moved to network/mod/ComfyQuestContracts/ModGlue/ and
       ships as the Comfy.Quest.Contracts NuGet package. contentFiles-only keeps this a single
       BepInEx DLL: the identical source compiles straight in, no separate assembly reference. -->
  <ItemGroup>
    <PackageReference Include="Comfy.Quest.Contracts" Version="0.1.0-local"
                       IncludeAssets="contentFiles" ExcludeAssets="compile;runtime" />
  </ItemGroup>

  <!-- The routed-RPC admission table (ValheimRoutedRpcAdmissions.cs, formerly linked from
       Lumberjacks/src/Game.Contracts/Valheim/) and the 4 Zdo/vehicle relevance policies (formerly
       native Core/Services files) moved to Lumberjacks/src/Comfy.Transport.Contracts/ and ship as
       the Comfy.Transport.Contracts NuGet package. contentFiles-only for the same single-DLL reason
       as Comfy.Quest.Contracts above. -->
  <ItemGroup>
    <PackageReference Include="Comfy.Transport.Contracts" Version="0.1.0-local"
                       IncludeAssets="contentFiles" ExcludeAssets="compile;runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

  <!-- Deploys go through the SHA-verified lanes (Deploy-Mod / Deploy-ToI5).
       The build only touches the live plugins folder when explicitly asked:
       an unguarded auto-copy once replaced the pinned DLL mid-program. -->
  <Target Name="CopyAssembly" AfterTargets="Build"
          Condition="Exists('$(PluginOutputPath)') And '$(ComfyCopyToPlugins)' == 'true'">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(PluginOutputPath)" />
  </Target>
</Project>
